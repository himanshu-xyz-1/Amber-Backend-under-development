APP_NAME=Amber
ENVIRONMENT=production
DEBUG=false
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000

CORS_ORIGINS=["https://ambersre.xyz","http://localhost:3000"]
# ==========================================
# Database Configuration
# Embedded SQLite (Zero-Config Default - No database installation required)
# ==========================================
DATABASE_URL=sqlite+aiosqlite:///./amber.db

# Optional Enterprise PostgreSQL (uncomment if running via Docker Compose or external RDS):
# DATABASE_URL=postgresql+asyncpg://amber:amber_secure_pass_2026@postgres:5432/amber_db
# POSTGRES_PASSWORD=amber_secure_pass_2026

REDIS_URL=redis://redis:6379/0
REDIS_ENABLED=true

JWT_SECRET_KEY=change_me_to_a_random_secret_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Intelligence Provider Key
GEMINI_API_KEY=

# Integrations
SLACK_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_CHAT_IDS=

# WhatsApp Self-Hosted QR Bridge

# Contact Intake
GMAIL_USER=amber.incident@gmail.com
GMAIL_APP_PASSWORD=

# Commercial License (Optional)
AMBER_LICENSE_KEY=
